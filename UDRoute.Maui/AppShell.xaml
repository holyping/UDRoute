<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UDRoute.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:UDRoute.Maui.Views"
    Title="UDRoute">

    <TabBar>
        <Tab Title="场境">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
        </Tab>
        <Tab Title="状态">
            <ShellContent ContentTemplate="{DataTemplate views:StatusPage}" Route="StatusPage" />
        </Tab>
        <Tab Title="日志">
            <ShellContent ContentTemplate="{DataTemplate views:LogPage}" Route="LogPage" />
        </Tab>
    </TabBar>
</Shell>
