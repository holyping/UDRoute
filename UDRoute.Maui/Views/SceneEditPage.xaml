<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:UDRoute.Maui.ViewModels"
             xmlns:converters="clr-namespace:UDRoute.Maui.Converters"
             x:Class="UDRoute.Maui.Views.SceneEditPage"
             x:Name="ThisPage"
             Title="编辑场境">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TabIndexToBoolConverter x:Key="TabToBoolConverter" />
            <converters:TabIndexToColorConverter x:Key="TabToColorConverter" />
            <converters:TabIndexToTextColorConverter x:Key="TabToTextColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- 1. 顶部操作与场境名称输入 -->
        <Border Grid.Row="0" Margin="10,5" Padding="12,8" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" Stroke="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="场境名称:" VerticalOptions="Center" FontAttributes="Bold" />
                <Entry Grid.Column="1" Text="{Binding SceneName}" Placeholder="例如：办公室远程办公" VerticalOptions="Center" />
                <Button Grid.Column="2" FontFamily="MaterialIcons" Text="&#xe161;" Command="{Binding SaveCommand}" BackgroundColor="#512BD4" TextColor="White" CornerRadius="8" WidthRequest="44" HeightRequest="40" Padding="0" FontSize="20" />
            </Grid>
        </Border>

        <!-- 2. 三大模式分栏选项卡 (Segmented Tabs) -->
        <Border Grid.Row="1" Margin="10,0,10,10" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" Padding="3" Stroke="Transparent">
            <Grid ColumnDefinitions="*,*,*">
                <!-- Tab 0: C 客户端 -->
                <Button Grid.Column="0" Text="C: 客户端" CornerRadius="8"
                        BackgroundColor="{Binding SelectedTabIndex, Converter={StaticResource TabToColorConverter}, ConverterParameter=0}"
                        TextColor="{Binding SelectedTabIndex, Converter={StaticResource TabToTextColorConverter}, ConverterParameter=0}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="0" FontAttributes="Bold" HeightRequest="38" Padding="0" />

                <!-- Tab 1: S 服务端 -->
                <Button Grid.Column="1" Text="S: 服务端" CornerRadius="8"
                        BackgroundColor="{Binding SelectedTabIndex, Converter={StaticResource TabToColorConverter}, ConverterParameter=1}"
                        TextColor="{Binding SelectedTabIndex, Converter={StaticResource TabToTextColorConverter}, ConverterParameter=1}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="1" FontAttributes="Bold" HeightRequest="38" Padding="0" />

                <!-- Tab 2: P 中转锚点 -->
                <Button Grid.Column="2" Text="P: 中转锚点" CornerRadius="8"
                        BackgroundColor="{Binding SelectedTabIndex, Converter={StaticResource TabToColorConverter}, ConverterParameter=2}"
                        TextColor="{Binding SelectedTabIndex, Converter={StaticResource TabToTextColorConverter}, ConverterParameter=2}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="2" FontAttributes="Bold" HeightRequest="38" Padding="0" />
            </Grid>
        </Border>

        <!-- 3. 主体内容区域 (ScrollView) -->
        <ScrollView Grid.Row="2" Padding="12,0,12,80">
            <Grid>
                
                <!-- ===================== PAGE 1: C: 客户端 ===================== -->
                <VerticalStackLayout IsVisible="{Binding SelectedTabIndex, Converter={StaticResource TabToBoolConverter}, ConverterParameter=0}" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                        <Label Text="客户端规则列表 (映射远端服务到本地端口)" VerticalOptions="Center" FontSize="12" TextColor="Gray" />
                        <Button Grid.Column="1" FontFamily="MaterialIcons" Text="&#xe145;" Command="{Binding AddClientCommand}" BackgroundColor="#10B981" TextColor="White" CornerRadius="6" WidthRequest="34" HeightRequest="34" Padding="0" FontSize="20" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding ClientItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ClientItemViewModel">
                                <Border Margin="0,0,0,12" Padding="12" StrokeShape="RoundRectangle 10" 
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}" 
                                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" StrokeThickness="1">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- 头部：生效开关 + 标题 + 删除 -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Switch IsToggled="{Binding IsEnabled}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Port, StringFormat='本地端口: {0}'}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Button Grid.Column="2" FontFamily="MaterialIcons" Text="&#xe872;" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=DeleteClientCommand}" CommandParameter="{Binding .}" BackgroundColor="#EF4444" TextColor="White" CornerRadius="6" WidthRequest="32" HeightRequest="30" Padding="0" FontSize="16" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" />

                                        <!-- 本地端口与协议 -->
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Grid.Column="0">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="本地监听端口" FontSize="12" TextColor="Gray" />
                                                    <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                            Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="C_Port" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                               TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Entry Text="{Binding Port}" Keyboard="Numeric" Placeholder="例如: 15389" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" WidthRequest="90">
                                                <Label Text="协议类型" FontSize="12" TextColor="Gray" />
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,6,0,0">
                                                    <Label Text="{Binding IsTcp, Converter={toolkit:BoolToObjectConverter TrueObject='TCP', FalseObject='UDP'}}" VerticalOptions="Center" FontAttributes="Bold" />
                                                    <Switch IsToggled="{Binding IsTcp}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- 目标服务名称 -->
                                        <VerticalStackLayout>
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="目标服务名称" FontSize="12" TextColor="Gray" />
                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="C_TargetName" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Entry Text="{Binding TargetName}" Placeholder="例如: rdp, ssh, web" />
                                        </VerticalStackLayout>

                                        <!-- 目标锚点服务器 (支持 Placeholder 默认值) -->
                                        <VerticalStackLayout>
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="目标中转服务器 (留空使用默认)" FontSize="12" TextColor="Gray" />
                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="C_TargetServer" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Entry Grid.Column="0" Text="{Binding TargetServer}" Placeholder="{Binding PlaceholderServer}" />
                                                <Button Grid.Column="1" FontFamily="MaterialIcons" Text="&#xea0b;" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=TestNatCommand}" 
                                                        CommandParameter="{Binding TargetServer}" 
                                                        BackgroundColor="#3B82F6" TextColor="White" CornerRadius="8" WidthRequest="38" HeightRequest="36" Padding="0" FontSize="18" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- 访问密码 -->
                                        <VerticalStackLayout>
                                            <Label Text="访问密码 (可选)" FontSize="12" TextColor="Gray" />
                                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="若服务端设置了密码则需输入" />
                                        </VerticalStackLayout>

                                        <!-- 高级设置折叠面板 -->
                                        <toolkit:Expander>
                                            <toolkit:Expander.Header>
                                                <Border Padding="8,4" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}" StrokeShape="RoundRectangle 6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Text="▼ 高级网络设置 (MTU, 强制中转等)" FontSize="12" TextColor="#6B7280" />
                                                    </Grid>
                                                </Border>
                                            </toolkit:Expander.Header>
                                            <toolkit:Expander.Content>
                                                <VerticalStackLayout Padding="4,8" Spacing="8">
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0">
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="MTU" FontSize="11" TextColor="Gray" />
                                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="General_MTU" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                                </Border>
                                                            </HorizontalStackLayout>
                                                            <Entry Text="{Binding Mtu}" Keyboard="Numeric" Placeholder="1400" />
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1">
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="强制中转" FontSize="11" TextColor="Gray" />
                                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="C_ForceRelay" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                                </Border>
                                                            </HorizontalStackLayout>
                                                            <Switch IsToggled="{Binding ForceRelay}" Margin="0,4,0,0" />
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0">
                                                            <Label Text="超时时间(秒)" FontSize="11" TextColor="Gray" />
                                                            <Entry Text="{Binding Timeout}" Keyboard="Numeric" Placeholder="0 为默认" />
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1">
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="心跳保活(秒)" FontSize="11" TextColor="Gray" />
                                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="General_KeepAlive" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                                </Border>
                                                            </HorizontalStackLayout>
                                                            <Entry Text="{Binding KeepAlive}" Keyboard="Numeric" Placeholder="25" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </toolkit:Expander.Content>
                                        </toolkit:Expander>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>


                <!-- ===================== PAGE 2: S: 服务端 ===================== -->
                <VerticalStackLayout IsVisible="{Binding SelectedTabIndex, Converter={StaticResource TabToBoolConverter}, ConverterParameter=1}" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                        <Label Text="服务端暴露服务列表 (向锚点注册本机/内网服务)" VerticalOptions="Center" FontSize="12" TextColor="Gray" />
                        <Button Grid.Column="1" FontFamily="MaterialIcons" Text="&#xe145;" Command="{Binding AddServerCommand}" BackgroundColor="#10B981" TextColor="White" CornerRadius="6" WidthRequest="34" HeightRequest="34" Padding="0" FontSize="20" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding ServerItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ServerItemViewModel">
                                <Border Margin="0,0,0,12" Padding="12" StrokeShape="RoundRectangle 10" 
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}" 
                                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" StrokeThickness="1">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- 头部：生效开关 + 标题 + 删除 -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Switch IsToggled="{Binding IsEnabled}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name, StringFormat='服务名: {0}'}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Button Grid.Column="2" FontFamily="MaterialIcons" Text="&#xe872;" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=DeleteServerCommand}" CommandParameter="{Binding .}" BackgroundColor="#EF4444" TextColor="White" CornerRadius="6" WidthRequest="32" HeightRequest="30" Padding="0" FontSize="16" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" />

                                        <!-- 服务标识名称 -->
                                        <VerticalStackLayout>
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="服务标识名称 (注册名)" FontSize="12" TextColor="Gray" />
                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="S_Name" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Entry Text="{Binding Name}" Placeholder="例如: rdp, ssh, file" />
                                        </VerticalStackLayout>

                                        <!-- 目标真实 IP 与端口 -->
                                        <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Grid.Column="0">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="目标真实IP" FontSize="12" TextColor="Gray" />
                                                    <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                            Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="S_TargetIp" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                               TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Entry Text="{Binding TargetIp}" Placeholder="127.0.0.1" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="目标端口" FontSize="12" TextColor="Gray" />
                                                    <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                            Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="S_TargetPort" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                               TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Entry Text="{Binding TargetPort}" Keyboard="Numeric" Placeholder="3389" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" WidthRequest="70">
                                                <Label Text="协议" FontSize="12" TextColor="Gray" />
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center" Margin="0,6,0,0">
                                                    <Label Text="{Binding IsTcp, Converter={toolkit:BoolToObjectConverter TrueObject='TCP', FalseObject='UDP'}}" VerticalOptions="Center" FontAttributes="Bold" />
                                                    <Switch IsToggled="{Binding IsTcp}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- 注册锚点服务器 (支持 Placeholder 默认值) -->
                                        <VerticalStackLayout>
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="注册锚点服务器 (留空使用默认)" FontSize="12" TextColor="Gray" />
                                                <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                        Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=ShowHelpCommand}" CommandParameter="S_TargetServer" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Entry Grid.Column="0" Text="{Binding TargetServer}" Placeholder="{Binding PlaceholderServer}" />
                                                <Button Grid.Column="1" FontFamily="MaterialIcons" Text="&#xea0b;" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SceneEditViewModel}}, Path=TestNatCommand}" 
                                                        CommandParameter="{Binding TargetServer}" 
                                                        BackgroundColor="#3B82F6" TextColor="White" CornerRadius="8" WidthRequest="38" HeightRequest="36" Padding="0" FontSize="18" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- 访问密码 -->
                                        <VerticalStackLayout>
                                            <Label Text="服务保护密码 (可选)" FontSize="12" TextColor="Gray" />
                                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="客户端必须携带此密码才能连接" />
                                        </VerticalStackLayout>

                                        <!-- 高级设置折叠面板 -->
                                        <toolkit:Expander>
                                            <toolkit:Expander.Header>
                                                <Border Padding="8,4" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}" StrokeShape="RoundRectangle 6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Text="▼ 高级参数 (注册周期、KCP加速等)" FontSize="12" TextColor="#6B7280" />
                                                    </Grid>
                                                </Border>
                                            </toolkit:Expander.Header>
                                            <toolkit:Expander.Content>
                                                <VerticalStackLayout Padding="4,8" Spacing="8">
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0">
                                                            <Label Text="注册间隔(秒)" FontSize="11" TextColor="Gray" />
                                                            <Entry Text="{Binding RegInterval}" Keyboard="Numeric" Placeholder="300" />
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1">
                                                            <Label Text="允许中转" FontSize="11" TextColor="Gray" />
                                                            <Switch IsToggled="{Binding AllowRelay}" Margin="0,4,0,0" />
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0">
                                                            <Label Text="MTU" FontSize="11" TextColor="Gray" />
                                                            <Entry Text="{Binding Mtu}" Keyboard="Numeric" Placeholder="1400" />
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1">
                                                            <Label Text="通道复用间隔(秒)" FontSize="11" TextColor="Gray" />
                                                            <Entry Text="{Binding TunnelReuseInterval}" Keyboard="Numeric" Placeholder="300" />
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <!-- KCP 参数次级折叠 -->
                                                    <toolkit:Expander Margin="0,4,0,0">
                                                        <toolkit:Expander.Header>
                                                            <Label Text="▸ KCP 协议调优参数" FontSize="11" TextColor="#4F46E5" />
                                                        </toolkit:Expander.Header>
                                                        <toolkit:Expander.Content>
                                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Padding="0,6">
                                                                <VerticalStackLayout Grid.Column="0">
                                                                    <Label Text="NoDelay" FontSize="10" TextColor="Gray" />
                                                                    <Switch IsToggled="{Binding KcpNoDelay}" />
                                                                </VerticalStackLayout>
                                                                <VerticalStackLayout Grid.Column="1">
                                                                    <Label Text="Interval(ms)" FontSize="10" TextColor="Gray" />
                                                                    <Entry Text="{Binding KcpInterval}" Keyboard="Numeric" />
                                                                </VerticalStackLayout>
                                                                <VerticalStackLayout Grid.Column="2">
                                                                    <Label Text="Resend" FontSize="10" TextColor="Gray" />
                                                                    <Entry Text="{Binding KcpResend}" Keyboard="Numeric" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </toolkit:Expander.Content>
                                                    </toolkit:Expander>
                                                </VerticalStackLayout>
                                            </toolkit:Expander.Content>
                                        </toolkit:Expander>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>


                <!-- ===================== PAGE 3: P: 中转锚点与全局设置 ===================== -->
                <VerticalStackLayout IsVisible="{Binding SelectedTabIndex, Converter={StaticResource TabToBoolConverter}, ConverterParameter=2}" Spacing="14">
                    
                    <!-- P 模式独立开关卡片 -->
                    <Border Padding="14" StrokeShape="RoundRectangle 10" 
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}" 
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="启用 P：中转锚点模式" FontAttributes="Bold" />
                                    <Label Text="作为公网中继节点，协助客户端与服务端打洞与转发" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding EnableProxy}" VerticalOptions="Center" />
                            </Grid>

                            <!-- P 模式开启后的配置 -->
                            <VerticalStackLayout IsVisible="{Binding EnableProxy}" Spacing="8">
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="监听端口" FontSize="12" TextColor="Gray" />
                                            <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                                    Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ShowHelpCommand}" CommandParameter="P_ProxyPort" />
                                                </Border.GestureRecognizers>
                                                <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                                       TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Entry Text="{Binding ProxyPort}" Keyboard="Numeric" Placeholder="9400" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="外网映射端口 (可选)" FontSize="12" TextColor="Gray" />
                                        <Entry Text="{Binding WanPort}" Keyboard="Numeric" Placeholder="0 为未配置" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="注册超时(秒)" FontSize="12" TextColor="Gray" />
                                        <Entry Text="{Binding RegTimeout}" Keyboard="Numeric" Placeholder="600" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="空闲断开阈值(秒)" FontSize="12" TextColor="Gray" />
                                        <Entry Text="{Binding IdleThreshold}" Keyboard="Numeric" Placeholder="60" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 全局默认与通用参数 -->
                    <Border Padding="14" StrokeShape="RoundRectangle 10" 
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}" 
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="全局默认设置 (对所有模式生效)" FontAttributes="Bold" />

                            <!-- 默认锚点服务器 (核心联动项) -->
                            <VerticalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="默认锚点服务器 (Default Server)" FontSize="12" TextColor="Gray" />
                                    <Border WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" 
                                            Stroke="Transparent" Padding="0" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowHelpCommand}" CommandParameter="P_DefaultServer" />
                                        </Border.GestureRecognizers>
                                        <Label Text="?" FontSize="10" FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" 
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry Grid.Column="0" Text="{Binding DefaultServer}" Placeholder="例如: pserver.example.com:9400" />
                                    <Button Grid.Column="1" FontFamily="MaterialIcons" Text="&#xea0b;" Command="{Binding TestNatCommand}" CommandParameter="{Binding DefaultServer}"
                                            BackgroundColor="#3B82F6" TextColor="White" CornerRadius="8" WidthRequest="38" HeightRequest="38" Padding="0" FontSize="18" />
                                </Grid>
                                <Label Text="💡 此处填写的服务器，将作为 C 客户端和 S 服务端留空时的默认值" FontSize="11" TextColor="#3B82F6" Margin="0,2,0,0" />
                            </VerticalStackLayout>

                            <!-- 设备名称 -->
                            <VerticalStackLayout>
                                <Label Text="设备识别名称 (可选)" FontSize="12" TextColor="Gray" />
                                <Entry Text="{Binding DevName}" Placeholder="可选，留空使用服务默认注册名" />
                            </VerticalStackLayout>

                            <!-- 高级设置折叠面板 -->
                            <toolkit:Expander>
                                <toolkit:Expander.Header>
                                    <Border Padding="8,4" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}" StrokeShape="RoundRectangle 6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="▼ 底层网络与调试参数" FontSize="12" TextColor="#6B7280" />
                                        </Grid>
                                    </Border>
                                </toolkit:Expander.Header>
                                <toolkit:Expander.Content>
                                    <VerticalStackLayout Padding="4,8" Spacing="8">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="握手探测超时(秒)" FontSize="11" TextColor="Gray" />
                                                <Entry Text="{Binding ProbeTimeout}" Keyboard="Numeric" Placeholder="5" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="全局保活周期(秒)" FontSize="11" TextColor="Gray" />
                                                <Entry Text="{Binding KeepAlive}" Keyboard="Numeric" Placeholder="25" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="最大请求记录数" FontSize="11" TextColor="Gray" />
                                                <Entry Text="{Binding MaxRecentRequests}" Keyboard="Numeric" Placeholder="100" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="全局强制中转" FontSize="11" TextColor="Gray" />
                                                <Switch IsToggled="{Binding ForceRelay}" Margin="0,4,0,0" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </toolkit:Expander.Content>
                            </toolkit:Expander>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!-- 4. 底部说明 Footer / Bottom Sheet (点击小问号弹出) -->
        <Border Grid.Row="3" Margin="8,0,8,8" Padding="16,12" StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                Stroke="#3B82F6" StrokeThickness="1"
                IsVisible="{Binding IsHelpVisible}">
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <!-- 顶部标题与右上角关闭按钮 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding HelpTitle}" FontAttributes="Bold" TextColor="White" FontSize="14" VerticalOptions="Center" />
                    <Button Grid.Column="1" FontFamily="MaterialIcons" Text="&#xe5cd;" Command="{Binding CloseHelpCommand}" 
                            BackgroundColor="Transparent" TextColor="#94A3B8" FontSize="18" 
                            WidthRequest="32" HeightRequest="32" Padding="0" />
                </Grid>
                <!-- 说明详情文本 -->
                <Label Grid.Row="1" Text="{Binding HelpContent}" TextColor="#E2E8F0" FontSize="13" LineHeight="1.2" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
