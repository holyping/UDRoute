<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:UDRoute.Maui.ViewModels"
             x:Class="UDRoute.Maui.Views.NatDiagnosticPage"
             Title="NAT 路由诊断结果">

    <ScrollView Padding="14">
        <VerticalStackLayout Spacing="16" MaximumWidthRequest="500" HorizontalOptions="Center">

            <!-- 目标服务器概览卡片 -->
            <Border Padding="14" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="测试目标服务器:" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding ServerAddress}" FontSize="16" FontAttributes="Bold" TextColor="#3B82F6" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="重新测试" Command="{Binding RunTestCommand}" 
                            IsEnabled="{Binding IsTesting, Converter={toolkit:InvertedBoolConverter}}"
                            BackgroundColor="#512BD4" TextColor="White" CornerRadius="8" HeightRequest="36" Padding="12,0" />
                </Grid>
            </Border>

            <!-- 测试中状态提示 -->
            <Border IsVisible="{Binding IsTesting}" Padding="16" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}"
                    Stroke="#3B82F6" StrokeThickness="1">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsTesting}" Color="#3B82F6" WidthRequest="36" HeightRequest="36" />
                    <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{AppThemeBinding Light=#1E40AF, Dark=#BFDBFE}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 诊断结果卡片区 -->
            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="14">

                <!-- 1. NAT 类型与打洞穿透能力 -->
                <Border Padding="14" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="NAT 穿透等级 / 类型" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="8,3" StrokeShape="RoundRectangle 6" BackgroundColor="{Binding NatLevelColor}" Stroke="Transparent">
                                <Label Text="{Binding NatLevelBadge}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Result.ConeDetail}" FontSize="13" TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" LineHeight="1.2" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. IPv4 连通状态 -->
                <Border Padding="14" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="IPv4 连通性" FontAttributes="Bold" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Ipv4Summary}" FontAttributes="Bold" FontSize="13" TextColor="#3B82F6" />
                        </Grid>
                        <Label Text="{Binding Result.Ipv4Detail}" FontSize="12" TextColor="Gray" LineHeight="1.2" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. IPv6 连通状态 -->
                <Border Padding="14" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="IPv6 连通性" FontAttributes="Bold" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Ipv6Summary}" FontAttributes="Bold" FontSize="13" 
                                   TextColor="{Binding Result.IsIpv6Direct, Converter={toolkit:BoolToObjectConverter TrueObject='#10B981', FalseObject='Gray'}}" />
                        </Grid>
                        <Label Text="{Binding Result.Ipv6Detail}" FontSize="12" TextColor="Gray" LineHeight="1.2" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. 详细探测过程日志 (Expander) -->
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Border Padding="10,6" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="▼ 展开完整诊断原始日志" FontSize="12" TextColor="#4B5563" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </toolkit:Expander.Header>
                    <toolkit:Expander.Content>
                        <Border Margin="0,6,0,0" Padding="10" StrokeShape="RoundRectangle 8" 
                                BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}">
                            <Label Text="{Binding RawLogs}" FontFamily="Courier" FontSize="11" TextColor="#94A3B8" LineHeight="1.2" />
                        </Border>
                    </toolkit:Expander.Content>
                </toolkit:Expander>

            </VerticalStackLayout>

            <!-- 返回按钮 -->
            <Button Text="返回" Command="{Binding CloseCommand}"
                    BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                    CornerRadius="10" HeightRequest="45" Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
