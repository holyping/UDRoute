<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AssemblyName>udroute</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="udroute_template_zh.ini" />
    <EmbeddedResource Include="udroute_template_en.ini" />
    <EmbeddedResource Include="udroute_help_zh.txt" />
    <EmbeddedResource Include="udroute_help_en.txt" />
  </ItemGroup>
</Project>